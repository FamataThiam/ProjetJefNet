# ------------------------------------------------------------------
# Configuration Docker de JefNet
# Copier ce fichier en « .env » à la racine du projet, puis remplir.
# Ce fichier .env contient des secrets : il ne doit jamais aller sur GitHub.
# ------------------------------------------------------------------

# port du site sur ton PC (80 = http://localhost ; mets 8000 si le port 80 est déjà pris)
WEB_PORT=80

APP_NAME=JefNet
APP_ENV=production
APP_DEBUG=false
# laisser vide : elle est créée automatiquement au premier lancement
APP_KEY=
# adresse du site ; les fichiers publics (photos) utilisent une adresse relative, valable sur tous les PC
APP_URL=http://localhost
PUBLIC_STORAGE_URL=/storage
FRONTEND_URL=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# base de données (le conteneur postgres est créé avec ces valeurs)
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=jefnet
DB_USERNAME=jefnet
DB_PASSWORD=change-moi

SESSION_DRIVER=database
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# temps réel : l'API parle à Reverb à l'intérieur de Docker
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=jefnet
REVERB_APP_KEY=change-moi-cle
REVERB_APP_SECRET=change-moi-secret
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http

# e-mails (Mailtrap) : reprendre les valeurs de backend/.env
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@jefnet.sn
MAIL_FROM_NAME=JefNet

# appels vidéo (Daily) : reprendre les valeurs de backend/.env
DAILY_API_KEY=
DAILY_DOMAIN=

# connexion Google / GitHub / Facebook (facultatif) : reprendre les valeurs de backend/.env
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=
